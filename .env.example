# Landing sozlamalari — hammasi BUILD vaqtida bundle'ga yoziladi (Vite VITE_*).
# Docker'da: Dockerfile ARG + .github/workflows/cd.yml build-args (GitHub environment `vars.*`).
# Lokal: shu faylni `.env.local` ga nusxalang.

# --- MAJBURIY (prod) ---
# Backend API origin (oxirida "/" siz). Docker build bo'sh bo'lsa YIQILADI.
# Lokal `vite dev`da bo'sh qoldirilsa http://localhost:3000 ishlatiladi.
VITE_API_URL=https://api.example.uz

# --- Telegram ---
# Bot username "@"siz. Bo'sh bo'lsa "Telegram botni ochish" bloki yashiriladi.
VITE_TELEGRAM_BOT_USERNAME=
# Klinika kanali (pastdagi Telegram tugma, suzuvchi tugma, footer ikonkasi). Bo'sh: https://t.me/zahrodentaluz
VITE_TELEGRAM_CHANNEL_URL=

# --- Klinika kontaktlari (bo'sh/placeholder bo'lsa tegishli tugma/qator YASHIRILADI) ---
# Telefon: +998901234567 yoki "+998 90 123 45 67". Bo'sh bo'lsa qo'ng'iroq tugmalari va raqam ko'rinmaydi.
VITE_CLINIC_PHONE=
VITE_CLINIC_EMAIL=
# Manzil tilma-til; bo'sh bo'lsa translations.ts'dagi matn.
VITE_CLINIC_ADDRESS_UZ=
VITE_CLINIC_ADDRESS_RU=
VITE_CLINIC_ADDRESS_EN=
# Xarita koordinatalari (bo'sh: 41.311081 / 69.279737 — taxminiy!)
VITE_CLINIC_LAT=
VITE_CLINIC_LNG=
# schema.org ish vaqti, ";" bilan ajratilgan. Bo'sh: "Mo-Sa 09:00-20:00;Su 10:00-17:00"
VITE_CLINIC_OPENING_HOURS=

# --- Ijtimoiy tarmoqlar (to'liq https:// havola; bo'sh bo'lsa ikonka yashiriladi) ---
VITE_INSTAGRAM_URL=
VITE_YOUTUBE_URL=
VITE_FACEBOOK_URL=
VITE_WHATSAPP_URL=

# --- SEO (ixtiyoriy) ---
# Sayt manzili https://domen (oxirida "/" siz): canonical, og:url, JSON-LD url, sitemap.xml, robots.txt Sitemap qatori.
VITE_SITE_URL=
